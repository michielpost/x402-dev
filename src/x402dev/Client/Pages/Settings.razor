@page "/settings"
@inject IThemeService ThemeService

<PageTitle>x402dev - Settings</PageTitle>

<div class="page-header">
    <span class="page-eyebrow">Preferences</span>
    <h1>Settings</h1>
    <p class="page-desc">Customize the appearance of x402dev to match your preferences.</p>
</div>

<FluentCard Style="max-width: 420px; padding: 0;">
    <div class="form-section">
        <p class="form-section-title">Theme</p>

        <FluentSelect TOption="ThemeMode"
                      TValue="ThemeMode"
                      Label="Color Mode"
                      Width="250px"
                      Items="@ThemeModes"
                      Value="@Mode"
                      ValueChanged="@OnModeChanged" />
    </div>
</FluentCard>

@code {

    public ThemeMode Mode { get; set; } = ThemeMode.System;

    private static readonly ThemeMode[] ThemeModes = Enum.GetValues<ThemeMode>();

    protected override async Task OnInitializedAsync()
    {
        var settings = await ThemeService.GetThemeSettingsAsync();
        Mode = settings?.Mode ?? ThemeMode.System;
    }

    private async Task OnModeChanged(ThemeMode mode)
    {
        Mode = mode;
        await ThemeService.SetThemeAsync(mode);
    }
}
