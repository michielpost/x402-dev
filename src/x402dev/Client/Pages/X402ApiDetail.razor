@page "/x402-apis/detail"
@inject IX402ApiGrpcService X402ApiGrpcService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using System.Text.Json
@using x402dev.Shared.Interfaces
@using x402dev.Shared.Models

<PageTitle>x402dev - API details</PageTitle>

@if (loadFailed)
{
	<div class="page-header">
		<span class="page-eyebrow">x402 Network</span>
		<h1>API details</h1>
		<p class="page-desc">API details are currently unavailable. Please try again later.</p>
		<div class="page-header-actions">
			<FluentButton Appearance="ButtonAppearance.Transparent" OnClick="@(() => Navigation.NavigateTo("x402-apis"))">Back to all APIs</FluentButton>
		</div>
	</div>
}
else if (api == null)
{
	<div class="page-loading">
		<FluentSpinner />
		<span>Loading API details…</span>
	</div>
}
else if (!found)
{
	<div class="page-header">
		<span class="page-eyebrow">x402 Network</span>
		<h1>API not found</h1>
		<p class="page-desc">This x402 API endpoint does not exist (or has not been checked yet).</p>
		<div class="page-header-actions">
			<FluentButton Appearance="ButtonAppearance.Transparent" OnClick="@(() => Navigation.NavigateTo("x402-apis"))">Back to all APIs</FluentButton>
		</div>
	</div>
}
else
{
	<div class="page-header">
		<span class="page-eyebrow">x402 API</span>
		<h1>@(string.IsNullOrWhiteSpace(api.ServiceName) ? api.Domain : api.ServiceName)</h1>
		<p class="page-desc">
			<a href="@api.Url" class="fac-url" target="_blank" rel="noopener">@api.Url</a>
		</p>
		<div class="page-header-actions">
			<span class="fac-status @(api.HasError ? "fac-status--offline" : "fac-status--online")">
				<span class="fac-status-dot"></span>
				@(api.HasError ? "Error" : "OK")
			</span>
		</div>
	</div>

	<FluentCard>
		<h3>Details</h3>
		<div class="detail-grid">
			<div class="detail-label">URL</div>
			<div class="detail-value">
				<a href="@api.Url" class="fac-url" target="_blank" rel="noopener">@api.Url</a>
				<FluentButton Appearance="ButtonAppearance.Transparent" Class="copy-btn" OnClick="@(() => CopyToClipboard(api.Url, "url"))" title="Copy URL">
					@(copiedKey == "url" ? "Copied!" : "Copy")
				</FluentButton>
			</div>

			<div class="detail-label">Domain</div>
			<div class="detail-value">
				<a href="https://@api.Domain" class="fac-url" target="_blank" rel="noopener">@api.Domain</a>
			</div>

			<div class="detail-label">Description</div>
			<div class="detail-value">
				@if (!string.IsNullOrWhiteSpace(api.Description))
				{
					<span>@api.Description</span>
				}
				else
				{
					<span class="fac-note">—</span>
				}
			</div>

			<div class="detail-label">Service name</div>
			<div class="detail-value">@(string.IsNullOrWhiteSpace(api.ServiceName) ? "—" : api.ServiceName)</div>

			<div class="detail-label">Version</div>
			<div class="detail-value">@(string.IsNullOrWhiteSpace(api.Version) ? "—" : api.Version)</div>

			<div class="detail-label">HTTP method</div>
			<div class="detail-value">@(string.IsNullOrWhiteSpace(api.HttpMethod) ? "—" : api.HttpMethod)</div>

			<div class="detail-label">Response time</div>
			<div class="detail-value">@(api.LatencyMs.HasValue ? $"{api.LatencyMs.Value} ms" : "—")</div>

			<div class="detail-label">Added</div>
			<div class="detail-value">@FormatDateTime(api.Added)</div>

			<div class="detail-label">Last check</div>
			<div class="detail-value">@(api.LastCheck.HasValue ? FormatDateTime(api.LastCheck.Value) : "—")</div>

			<div class="detail-label">Next check</div>
			<div class="detail-value">@(api.NextCheck.HasValue ? FormatDateTime(api.NextCheck.Value) : "—")</div>

			<div class="detail-label">Last success</div>
			<div class="detail-value">@(api.LastSuccess.HasValue ? FormatDateTime(api.LastSuccess.Value) : "—")</div>

			<div class="detail-label">Last error</div>
			<div class="detail-value">@(api.LastError.HasValue ? FormatDateTime(api.LastError.Value) : "—")</div>

			@if (!string.IsNullOrWhiteSpace(api.ErrorMessage))
			{
				<div class="detail-label">Error</div>
				<div class="detail-value detail-error">@api.ErrorMessage</div>
			}
		</div>
	</FluentCard>

	<FluentCard Style="margin-top: 1rem;">
		<h3>Quick start</h3>
		<p class="page-desc">
			Call this endpoint and handle the x402 payment handshake: request the resource,
			then sign the <code>PAYMENT-REQUIRED</code> response and retry with a
			<code>PAYMENT-SIGNATURE</code> header.
		</p>

		<div class="detail-grid">
			<div class="detail-label">Test live</div>
			<div class="detail-value">
				<FluentAnchorButton Appearance="ButtonAppearance.Primary"
									Href="@($"/resource-tester?url={Uri.EscapeDataString(api.Url)}&method={Uri.EscapeDataString(string.IsNullOrWhiteSpace(api.HttpMethod) ? "GET" : api.HttpMethod)}")">
					Test in Resource Tester
				</FluentAnchorButton>
			</div>
		</div>

		<div class="quickstart-tabs">
			@foreach (var lang in SampleLanguages)
			{
				<FluentButton Appearance="@(selectedSample == lang.Key ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
							  OnClick="@(() => selectedSample = lang.Key)">@lang.Label</FluentButton>
			}
		</div>
		<pre class="code-block">@SelectedSampleCode</pre>
		<FluentButton Appearance="ButtonAppearance.Transparent" Class="copy-btn" OnClick="@(() => CopyToClipboard(SelectedSampleCode, "sample"))" title="Copy code sample">
			@(copiedKey == "sample" ? "Copied!" : "Copy")
		</FluentButton>
	</FluentCard>

	<FluentCard Style="margin-top: 1rem;">
		<h3>Payment methods</h3>
		@if (api.Requirements?.Count > 0)
		{
			<FluentDataGrid Id="x402apidetailpay" Items="@(api.Requirements.AsQueryable())" TGridItem="X402ApiPaymentRequirement" AutoFit="true">
				<TemplateColumn Title="Network" Sortable="true" Align="DataGridCellAlignment.Start" SortBy="@(GridSort<X402ApiPaymentRequirement>.ByAscending(r => r.NetworkName ?? r.Network))">
					<span>@(context.NetworkName ?? context.Network)</span>
					<p class="fac-note">@context.Network</p>
				</TemplateColumn>
				<TemplateColumn Title="Amount" Sortable="true" Align="DataGridCellAlignment.Start" SortBy="@(GridSort<X402ApiPaymentRequirement>.ByAscending(r => r.AmountFormatted ?? r.Amount))">
					<span>@(context.AmountFormatted ?? context.Amount) @(context.AssetName ?? context.Asset)</span>
					<p class="fac-note">@context.Amount</p>
				</TemplateColumn>
				<TemplateColumn Title="Asset / Contract" Sortable="true" Align="DataGridCellAlignment.Start" SortBy="@(GridSort<X402ApiPaymentRequirement>.ByAscending(r => r.AssetName ?? r.Asset))">
					<span>@(context.AssetName ?? context.Asset)</span>
					<p class="fac-note fac-url">@context.Asset</p>
				</TemplateColumn>
			</FluentDataGrid>
		}
		else
		{
			<p class="fac-note">No payment requirements recorded.</p>
		}
	</FluentCard>

	<FluentCard Style="margin-top: 1rem;">
		<h3>Raw JSON response</h3>
		@if (!string.IsNullOrWhiteSpace(prettyJson))
		{
			<div class="debug-log">
				<div class="debug-log-label">
					<FluentButton Appearance="ButtonAppearance.Transparent" Class="copy-btn" OnClick="@(() => CopyToClipboard(api.RawJsonResponse ?? prettyJson, "json"))" title="Copy JSON">
						@(copiedKey == "json" ? "Copied!" : "Copy")
					</FluentButton>
				</div>
				<pre>@prettyJson</pre>
			</div>
		}
		else
		{
			<p class="fac-note">No raw response recorded.</p>
		}
	</FluentCard>


	@if (hasOtherDomainApis)
	{
		<div class="page-header" Style="margin-top: 2rem;">
			<span class="page-eyebrow">@api.Domain</span>
			<h2>Other APIs on this domain</h2>
		</div>

		<X402ApiList Domain="@api.Domain" ExcludeUrl="@api.Url" ShowSearch="false" ShowDomainColumn="false" />
	}
}

@code {
	[SupplyParameterFromQuery(Name = "url")] public string? UrlParam { get; set; }

	private X402Api? api;
	private bool hasOtherDomainApis;
	private bool found;
	private bool loadFailed;
	private string? prettyJson;
	private string? copiedKey;
	private string selectedSample = "curl";

	private static readonly (string Key, string Label)[] SampleLanguages =
	[
		("curl", "curl"),
		("javascript", "JavaScript"),
		("python", "Python"),
		("go", "Go"),
	];

	private string HttpMethod => (api?.HttpMethod ?? "GET").ToUpperInvariant();

	private string SelectedSampleCode => selectedSample switch
	{
		"javascript" => JavaScriptSample,
		"python" => PythonSample,
		"go" => GoSample,
		_ => CurlSample,
	};

	private string CurlSample => $$"""
		# 1) Request the resource
		curl -i -X {{HttpMethod}} '{{api?.Url}}'

		# 2) If the response is 402 Payment Required, the PAYMENT-REQUIRED
		#    header contains base64-encoded payment requirements. Sign them
		#    with your wallet (e.g. the x402 SDK) and retry:
		curl -i -X {{HttpMethod}} '{{api?.Url}}' \
		  -H 'PAYMENT-SIGNATURE: <base64 payload>'
		""";

	private string JavaScriptSample => $$"""
		const url = '{{api?.Url}}';

		// 1) Request the resource
		let res = await fetch(url, { method: '{{HttpMethod}}' });

		// 2) If payment is required, sign the requirements and retry
		if (res.status === 402) {
		  const requirements = JSON.parse(atob(res.headers.get('PAYMENT-REQUIRED')));
		  const signature = await signPayment(requirements); // sign with your wallet / x402 SDK
		  res = await fetch(url, {
		    method: '{{HttpMethod}}',
		    headers: { 'PAYMENT-SIGNATURE': signature },
		  });
		}

		const data = await res.json();
		console.log(data);
		""";

	private string PythonSample => $$"""
		import base64
		import json
		import requests

		url = '{{api?.Url}}'

		# 1) Request the resource
		res = requests.request('{{HttpMethod}}', url)

		# 2) If payment is required, sign the requirements and retry
		if res.status_code == 402:
		    requirements = json.loads(base64.b64decode(res.headers['PAYMENT-REQUIRED']))
		    signature = sign_payment(requirements)  # sign with your wallet / x402 SDK
		    res = requests.request('{{HttpMethod}}', url, headers={'PAYMENT-SIGNATURE': signature})

		print(res.json())
		""";

	private string GoSample => $$"""
		package main

		import (
			"encoding/base64"
			"encoding/json"
			"fmt"
			"io"
			"net/http"
		)

		const url = "{{api?.Url}}"

		func main() {
			// 1) Request the resource
			req, _ := http.NewRequest("{{HttpMethod}}", url, nil)
			res, err := http.DefaultClient.Do(req)
			if err != nil {
				panic(err)
			}

			// 2) If payment is required, sign the requirements and retry
			if res.StatusCode == http.StatusPaymentRequired {
				raw, _ := base64.StdEncoding.DecodeString(res.Header.Get("PAYMENT-REQUIRED"))
				var requirements map[string]any
				_ = json.Unmarshal(raw, &requirements)

				signature, _ := signPayment(requirements) // sign with your wallet / x402 SDK
				req, _ = http.NewRequest("{{HttpMethod}}", url, nil)
				req.Header.Set("PAYMENT-SIGNATURE", signature)
				res, err = http.DefaultClient.Do(req)
				if err != nil {
					panic(err)
				}
			}

			body, _ := io.ReadAll(res.Body)
			defer res.Body.Close()
			fmt.Println(string(body))
		}
		""";

	private async Task CopyToClipboard(string text, string key)
	{
		await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
		copiedKey = key;
		StateHasChanged();
		_ = ResetCopiedKeyAsync(key);
	}

	private async Task ResetCopiedKeyAsync(string key)
	{
		await Task.Delay(2000);
		if (copiedKey == key)
		{
			copiedKey = null;
			StateHasChanged();
		}
	}

	protected override async Task OnInitializedAsync()
	{
		if (string.IsNullOrWhiteSpace(UrlParam))
		{
			return;
		}

		try
		{
			var result = await X402ApiGrpcService.GetX402ApiDetail(new GetX402ApiDetailRequest { Url = UrlParam });
			found = result.Found;
			api = result.Api;

			if (api != null)
			{
				prettyJson = PrettyJson(api.RawJsonResponse);

				try
				{
					var domainResult = await X402ApiGrpcService.GetX402ApisPaged(new GetX402ApisPagedRequest
					{
						Domain = api.Domain,
						ExcludeUrl = api.Url,
						Take = 1
					});
					hasOtherDomainApis = domainResult.TotalCount > 0;
				}
				catch
				{
					// Optional "other APIs on this domain" section is omitted when the backend is unreachable.
					hasOtherDomainApis = false;
				}
			}
		}
		catch
		{
			// Backend (or its gRPC endpoint) unreachable — render the page without API data instead of failing.
			loadFailed = true;
		}
	}

	private static string PrettyJson(string? json)
	{
		if (string.IsNullOrWhiteSpace(json))
		{
			return string.Empty;
		}

		try
		{
			using var doc = JsonDocument.Parse(json);
			return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
		}
		catch (JsonException)
		{
			return json;
		}
	}

	private static string FormatDateTime(DateTime dt)
	{
		return dt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
	}
}
