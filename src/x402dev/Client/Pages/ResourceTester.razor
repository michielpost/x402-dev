@page "/resource-tester"
@using System.Text.Json
@using System.Net.Http.Json
@using System.Globalization
@using System.Text
@using Nethereum.Hex.HexTypes
@using x402.Client.EVM
@using x402.Client.Events
@using x402.Client.v2
@using x402.Core.Enums
@using x402.Core.Interfaces
@using x402.Core.Models.v2
@using x402dev.Server.Models
@inject IHttpClientFactory HttpClientFactory
@inject IAssetInfoProvider AssetInfoProvider
@inherits BaseMetaMaskPage

<PageTitle>x402dev - Resource Tester</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
    <div class="page-header">
        <span class="page-eyebrow">Developer Tool</span>
        <h1>Resource Tester</h1>
        <p class="page-desc">
            Send requests to x402-protected endpoints and inspect payment flows,
            response headers, and authentication in real time.
        </p>
    </div>

    <FluentCard>
        <div class="form-section">
            <p class="form-section-title">Request</p>
            <FluentTextInput @bind-Value="@url"
                             Label="URL"
                             Style="width: 100%;"
                             Placeholder="https://api2.x402dev.com/demo/protected"
                             Required="true" />

            @if (!hasUrlParam)
            {
                <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                    <span style="font-size:0.875rem; color:var(--neutral-foreground-hint,#888);">Example endpoints:</span>
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => url = ExactExampleUrl)">exact</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => url = UptoExampleUrl)">upto</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => url = BatchExampleUrl)">batch-settlement</FluentButton>
                </div>
            }

            @if (!hasMethodParam)
            {
                <FluentSelect TOption="string"
                              TValue="string"
                              Items="@HttpMethods"
                              @bind-Value="@httpMethod"
                              Label="HTTP Method"
                              Style="width: 200px;" />
            }

            @if (!IsGetMethod)
            {
                <FluentTextArea @bind-Value="@requestContent"
                                Label="Request body (optional)"
                                Style="width: 100%;"
                                Placeholder='{"key": "value"}'
                                Resize="TextAreaResize.Vertical" />
            }

            <FluentTextInput @bind-Value="@paymentHeader"
                             Label="Optional PAYMENT-SIGNATURE header"
                             Style="width: 100%;"
                             Placeholder="Leave empty to use MetaMask for payment…" />

            @if (isLoading && networkOptions == null)
            {
                <div style="display:flex; align-items:center; gap:0.6rem;">
                    <FluentSpinner />
                    <span style="font-size:0.875rem; color:var(--neutral-foreground-hint,#888);">Fetching…</span>
                </div>
            }
            else
            {
                <div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  OnClick="FetchResource"
                                  Disabled="@isLoading">Fetch Resource</FluentButton>
                    @if (isLoading)
                    {
                        <span style="font-size:0.875rem; color:var(--neutral-foreground-hint,#888);">Waiting for network selection…</span>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(result))
            {
                <div>
                    <p class="debug-log-label">Debug Log</p>
                    <div class="debug-log">@result</div>
                </div>
            }
        </div>
    </FluentCard>

    @if (networkOptions is { Count: > 1 })
    {
        <FluentCard>
            <div class="form-section">
                <p class="form-section-title">Select payment network</p>
                <p style="margin:0; font-size:0.875rem; color:var(--neutral-foreground-hint,#888);">
                    This resource accepts payment on multiple networks. Choose the network you want to pay on.
                </p>

                <div class="network-options">
                    @foreach (var option in networkOptions)
                    {
                        <button type="button"
                                class="network-option"
                                disabled="@(!option.IsSupported)"
                                @onclick="@(() => SelectNetwork(option))">
                            <span class="network-option-name">@option.Name</span>
                            <span class="network-option-detail">@option.Detail</span>
                            @if (!option.IsSupported)
                            {
                                <span class="network-option-note">@option.UnsupportedReason</span>
                            }
                        </button>
                    }
                </div>

                <div>
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="CancelNetworkSelection">Cancel</FluentButton>
                </div>
            </div>
        </FluentCard>
    }

    @if (needsMetaMask)
    {
        <Metamask SelectedAccountTruncateLength="15" ConnectText="Connect Wallet" InstallMetamaskText="Install MetaMask" />
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">
            @errorMessage
        </FluentMessageBar>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <FluentMessageBar Intent="MessageBarIntent.Success">
            @successMessage
        </FluentMessageBar>
    }

    @*     @if (headers != null)
    {
        <FluentCard>
            <h3>Response Headers</h3>
            <FluentTextArea Style="width: 100%; min-height: 100%;"
                          Label="Response Headers"
                          Value="@headers"
                            Resize="TextAreaResize.Both"
                          ReadOnly="true" />
        </FluentCard>
    } *@

    @if (content != null)
    {
        <FluentCard>
            <FluentTextArea Style="width: 100%; min-height: 100%;"
                            Label="x402 Response"
                            Value="@content"
                            Resize="TextAreaResize.Both"
                            Height="@($"{lineCount * 24}px")"
                            ReadOnly="true" />
        </FluentCard>
    }

    @if (finalResult != null)
    {
        <FluentCard>
            <FluentTextArea Style="width: 100%; min-height: 100%;"
                            Label="Final Response"
                            Value="@finalResult"
                            Resize="TextAreaResize.Both"
                            Height="@($"{lineCountFinalResult * 24}px")"
                            ReadOnly="true" />
        </FluentCard>
    }
</FluentStack>

    @code {
    private const string ExactExampleUrl = "https://api2.x402dev.com/demo/protected";
    private const string UptoExampleUrl = "https://api2.x402dev.com/demo/upto";
    private const string BatchExampleUrl = "https://api2.x402dev.com/demo/batch-settlement";

    private static readonly List<string> HttpMethods = new()
    {
        "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"
    };

    private string url = ExactExampleUrl;
    private string httpMethod = "GET";
    private string? requestContent;
    private string? paymentHeader;
    private string? headers;
    private string? result;
    private string? finalResult;
    private string? content;
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;
    private bool needsMetaMask;
    private int lineCount = 0;
    private int lineCountFinalResult = 0;

    private List<NetworkOption>? networkOptions;
    private TaskCompletionSource<string?>? networkSelection;
    private bool isDisposed;

    private bool hasUrlParam;
    private bool hasMethodParam;

    private bool IsGetMethod => string.Equals(httpMethod, "GET", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// A payment network offered by the resource, shown in the network picker.
    /// </summary>
    private sealed record NetworkOption(
        string Network,
        string Name,
        string Detail,
        bool IsSupported,
        string? UnsupportedReason);

    private static readonly Dictionary<string, string> KnownNetworkNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["eip155:1"] = "Ethereum",
        ["eip155:8453"] = "Base",
        ["eip155:84532"] = "Base Sepolia",
        ["eip155:137"] = "Polygon",
        ["eip155:80002"] = "Polygon Amoy",
        ["eip155:43114"] = "Avalanche",
        ["eip155:43113"] = "Avalanche Fuji",
        ["eip155:50"] = "XDC",
        ["eip155:51"] = "XDC Apothem",
        ["eip155:4689"] = "IoTeX",
        ["eip155:3338"] = "Peaq",
        ["solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"] = "Solana",
        ["solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1"] = "Solana Devnet",
    };

    [SupplyParameterFromQuery(Name = "url")] public string? UrlParam { get; set; }
    [SupplyParameterFromQuery(Name = "method")] public string? MethodParam { get; set; }


    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (!string.IsNullOrWhiteSpace(UrlParam))
        {
            url = UrlParam;
            hasUrlParam = true;
        }

        if (!string.IsNullOrWhiteSpace(MethodParam) &&
            HttpMethods.Contains(MethodParam.Trim().ToUpperInvariant(), StringComparer.OrdinalIgnoreCase))
        {
            httpMethod = MethodParam.Trim().ToUpperInvariant();
            hasMethodParam = true;
        }

        WalletProvider.PrepareWallet += WalletProvider_PrepareWallet;
        WalletProvider.PaymentSelected += WalletProvider_PaymentSelected;
        WalletProvider.HeaderCreated += WalletProvider_HeaderCreated;
    }

    public override void Dispose()
    {
        isDisposed = true;
        networkSelection?.TrySetResult(null);

        base.Dispose();

        WalletProvider.PrepareWallet -= WalletProvider_PrepareWallet;
        WalletProvider.PaymentSelected -= WalletProvider_PaymentSelected;
        WalletProvider.HeaderCreated -= WalletProvider_HeaderCreated;
    }

    private void WriteResultLine(string line)
    {
        result += line + "\r\n";
        StateHasChanged();
    }


    private async Task<bool> WalletProvider_PrepareWallet(object? sender, PrepareWalletEventArgs<PaymentRequiredResponse> eventArgs)
    {
        //Show it
        // Try to format if JSON
        try
        {
            content = JsonSerializer.Serialize(eventArgs.PaymentRequiredResponse, new JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
        }

        if (content != null)
        {
            lineCount = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None).Length;
            lineCount = int.Max(10, lineCount);
        }

        WriteResultLine("Preparing wallet for x402 payment requirements");

        var accepts = eventArgs.PaymentRequiredResponse.Accepts;

        if (accepts.Count == 0)
        {
            errorMessage = "No payment requirements found in x402 response";
            return false;
        }

        var options = BuildNetworkOptions(accepts);
        var networks = options.Select(x => x.Network).ToList();

        if (networks.Count > 1)
        {
            WriteResultLine($"Received x402 requirements for these networks: ");
            WriteResultLine(string.Join(", ", networks));
        }
        else
        {
            WriteResultLine($"Received x402 requirements for network: {string.Join(", ", networks)}");
        }

        var schemes = accepts.Select(x => x.Scheme).Distinct().ToList();
        WriteResultLine($"Offered payment scheme(s): {string.Join(", ", schemes)}");

        if (string.IsNullOrEmpty(paymentHeader) && options.Any(x => x.IsSupported))
        {
            needsMetaMask = true;
        }

        string? network;

        if (options.Count == 1 || !options.Any(x => x.IsSupported))
        {
            network = options[0].Network;
        }
        else
        {
            network = await SelectNetworkAsync(options);

            if (network == null)
            {
                WriteResultLine("Payment cancelled: no network selected.");
                return false;
            }

            WriteResultLine($"Selected network: {network}");
        }

        //Get known assets
        var assetInfos = AssetInfoProvider.GetAssetInfoByNetwork(network);
        var assetInfo = assetInfos.FirstOrDefault();
        if (assetInfo != null)
        {
            WriteResultLine($"Known network: {assetInfo.Network} ({assetInfo.ChainId})");
        }
        else
        {
            WriteResultLine($"Unknown network: {network}");
            errorMessage = $"No asset info found for network: {network}";
            return false;
        }

        if (assetInfo.NetworkType == x402.Core.Models.NetworkType.EVM)
        {
            if (needsMetaMask)
            {
                if (_ethereumHostProvider == null)
                {
                    WriteResultLine($"Enable MetaMask to proceed.");
                    errorMessage = "MetaMask not available. Please install or enable MetaMask to sign this payment.";
                    return false;
                }

                if (SelectedAccount == null)
                {
                    WriteResultLine("No account selected in MetaMask");
                    errorMessage = "Please connect MetaMask";
                    return false;
                }

                WriteResultLine($"Preparing wallet");

                var web3 = await _ethereumHostProvider.GetWeb3Async();

                var chainId = new HexBigInteger(assetInfo.ChainId);

                var changeResult = await ChangeChainTo(assetInfo.ChainId);
                if (!string.IsNullOrEmpty(changeResult))
                {
                    WriteResultLine($"Error changing MetaMask to ChainId: {assetInfo.ChainId}: {changeResult}");
                    errorMessage = $"Failed to change MetaMask to ChainId: {assetInfo.ChainId}: {changeResult}";
                    return false;
                }
                else
                {
                    WriteResultLine($"Changed MetaMask to ChainId: {assetInfo.ChainId}");
                }


                var selectedChainId = await web3.Eth.ChainId.SendRequestAsync();
                if (selectedChainId.Value != chainId.Value)
                {
                    WriteResultLine("Failed to change chainId");
                    errorMessage = "Failed to change chainId in MetaMask";
                    return false;
                }



                var wallet = new EVMWallet((s) => web3.Eth.AccountSigning.SignTypedDataV4.SendRequestAsync(s), SelectedAccount, assetInfo.Network, assetInfo.ChainId)
                    {
                        IgnoreAllowances = true
                    };
                WalletProvider.Wallet = wallet;
            }

            return true;
        }
        else
        {
            errorMessage = $"Unsupported network: {network}. Automatic signing using Metamask is only supported for EVM networks.";
            return false;
        }
    }

    /// <summary>
    /// Builds one selectable option per distinct network offered by the resource.
    /// </summary>
    private List<NetworkOption> BuildNetworkOptions(IEnumerable<PaymentRequirements> accepts)
    {
        var options = new List<NetworkOption>();

        foreach (var group in accepts.GroupBy(x => x.Network))
        {
            var requirement = group.First();
            var assetInfo = AssetInfoProvider.GetAssetInfoByNetwork(group.Key).FirstOrDefault();
            var isSupported = assetInfo?.NetworkType == x402.Core.Models.NetworkType.EVM;

            var name = KnownNetworkNames.TryGetValue(group.Key, out var knownName) ? knownName : group.Key;

            var detail = new List<string>();
            if (!string.Equals(name, group.Key, StringComparison.OrdinalIgnoreCase))
            {
                detail.Add(group.Key);
            }

            detail.Add(FormatAmount(requirement.Amount, assetInfo));
            detail.Add(JsonNamingPolicy.KebabCaseLower.ConvertName(requirement.Scheme.ToString()));

            if (group.Count() > 1)
            {
                detail.Add($"{group.Count()} payment options");
            }

            options.Add(new NetworkOption(
                group.Key,
                name,
                string.Join(" · ", detail),
                isSupported,
                isSupported ? null : "Not supported — MetaMask can only sign EVM payments."));
        }

        return options;
    }

    private static string FormatAmount(string amount, x402.Core.Models.AssetInfo? assetInfo)
    {
        if (assetInfo != null
            && decimal.TryParse(amount, NumberStyles.Integer, CultureInfo.InvariantCulture, out var raw))
        {
            var value = raw / (decimal)Math.Pow(10, assetInfo.Decimals);
            var formatted = value.ToString("0.######", CultureInfo.InvariantCulture);

            return string.IsNullOrEmpty(assetInfo.Name) ? formatted : $"{formatted} {assetInfo.Name}";
        }

        return amount;
    }

    /// <summary>
    /// Shows the network picker and waits for the user to choose a network (or cancel).
    /// Returns null when the user cancelled.
    /// </summary>
    private async Task<string?> SelectNetworkAsync(List<NetworkOption> options)
    {
        networkOptions = options;
        networkSelection = new TaskCompletionSource<string?>(TaskCreationOptions.RunContinuationsAsynchronously);

        WriteResultLine("Multiple networks offered — waiting for network selection.");
        await InvokeAsync(StateHasChanged);

        try
        {
            return await networkSelection.Task;
        }
        finally
        {
            networkOptions = null;
            networkSelection = null;

            if (!isDisposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void SelectNetwork(NetworkOption option)
    {
        if (!option.IsSupported)
        {
            return;
        }

        networkSelection?.TrySetResult(option.Network);
    }

    private void CancelNetworkSelection()
    {
        networkSelection?.TrySetResult(null);
    }

    private void WalletProvider_PaymentSelected(object? sender, PaymentSelectedEventArgs<PaymentRequirements> eventArgs)
    {
        if (eventArgs.PaymentRequirements == null)
        {
            WriteResultLine("No payment selected");
        }
        else
        {
            WriteResultLine($"Payment selected: {eventArgs.PaymentRequirements.Amount} {eventArgs.PaymentRequirements.Asset} on {eventArgs.PaymentRequirements.Network} (scheme: {eventArgs.PaymentRequirements.Scheme})");

            if (eventArgs.PaymentRequirements.Scheme != PaymentScheme.Exact)
            {
                WriteResultLine("The amount is the authorized maximum — the server settles only the actual usage.");
            }
        }
    }

    private void WalletProvider_HeaderCreated(object? sender, HeaderCreatedEventArgs<PaymentPayloadHeader> eventArgs)
    {
        WriteResultLine("Payment header created:");
        WriteResultLine($"Payload: {eventArgs.PaymentPayloadHeader.ToBase64Header()}");

        paymentHeader = eventArgs.PaymentPayloadHeader.ToBase64Header();
    }


    private async Task FetchResource()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            headers = null;
            content = null;
            successMessage = null;
            finalResult = null;
            result = null;
            networkSelection?.TrySetResult(null);
            networkOptions = null;

            if (string.IsNullOrWhiteSpace(url))
            {
                errorMessage = "Please enter a URL";
                return;
            }

            var req = new ProxyRequest
            {
                Url = url,
                PaymentHeader = paymentHeader,
                HttpMethod = httpMethod,
                RequestContent = IsGetMethod ? null : requestContent
            };
            var json = JsonSerializer.Serialize(req);

            var request = new HttpRequestMessage(HttpMethod.Post, "/api/proxy/proxy-x402")
            {
                Content = new StringContent(json, Encoding.UTF8, "application/json")
            };

            var httpClient = HttpClientFactory.CreateClient("x402");
            var response = await httpClient.SendAsync(request);

            var responseContent = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var paymentResponse = response.ReadSettlementResponseHeader();

                if (paymentResponse != null && paymentResponse.Success)
                {
                    successMessage = $"Success! Tx: {paymentResponse.Transaction}";
                }
                
            }

            // Try to format if JSON
            try
            {
                using var doc = JsonDocument.Parse(responseContent);
                finalResult = JsonSerializer.Serialize(doc, new JsonSerializerOptions
                {
                    WriteIndented = true
                });
            }
            catch
            {
                // If not valid JSON, show as plain text
                finalResult = responseContent;
            }

            lineCountFinalResult = finalResult.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None).Length;
            lineCountFinalResult = int.Max(10, lineCountFinalResult);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}