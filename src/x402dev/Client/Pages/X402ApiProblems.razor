@page "/x402-apis/errors"
@inject IX402ApiGrpcService X402ApiGrpcService
@inject NavigationManager Navigation
@using x402dev.Shared.Interfaces
@using x402dev.Shared.Models

<PageTitle>x402dev - x402 API Problems</PageTitle>

<div class="page-header">
	<span class="page-eyebrow">x402 Network</span>
	<h1>x402 API Problems</h1>
	<p class="page-desc">
		x402-protected API endpoints that currently have an error or have not been
		checked yet. This page is not part of the menu.
	</p>
</div>

<X402ApiList @ref="apiList" Mode="ListMode.Problems" />

<FluentCard Style="margin-top: 1.5rem;">
	<h3>Add an x402 API endpoint</h3>
	<p class="page-desc">
		Submit an x402-protected URL. It will be checked automatically and added to the list.
	</p>
	<FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="8">
		<FluentTextField @bind-Value="@newUrl"
						 Style="width: 420px; max-width: 100%;"
						 Placeholder="https://api.example.com/protected-resource"
						 aria-label="API URL"
						 Required="true" />
		<FluentButton Appearance="Appearance.Accent" OnClick="AddApi" Disabled="@isAdding">Add</FluentButton>
	</FluentStack>

	@if (!string.IsNullOrEmpty(addMessage))
	{
		<FluentMessageBar Intent="@AddIntent"
						  Style="margin-top: 0.5rem;">
			@addMessage
		</FluentMessageBar>
	}
</FluentCard>

@code {
	private X402ApiList apiList = default!;
	private string newUrl = string.Empty;
	private string? addMessage;
	private bool addSuccess;
	private bool isAdding;
	private MessageIntent AddIntent => addSuccess ? MessageIntent.Success : MessageIntent.Error;

	protected override Task OnInitializedAsync() => Task.CompletedTask;

	private async Task AddApi()
	{
		if (string.IsNullOrWhiteSpace(newUrl))
		{
			addSuccess = false;
			addMessage = "Please enter a URL.";
			return;
		}

		try
		{
			isAdding = true;
			addMessage = null;

			var result = await X402ApiGrpcService.AddX402Api(new AddX402ApiRequest { Url = newUrl.Trim() });

			addSuccess = result.Success;
			addMessage = result.Success
				? "URL added. It will be checked within a few minutes."
				: result.Error ?? "The URL could not be added.";

			if (result.Success)
			{
				newUrl = string.Empty;
				await apiList.RefreshAsync();
			}
		}
		catch (Exception ex)
		{
			addSuccess = false;
			addMessage = $"Error: {ex.Message}";
		}
		finally
		{
			isAdding = false;
		}
	}
}
