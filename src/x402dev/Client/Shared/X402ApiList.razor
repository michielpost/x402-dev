@using x402dev.Shared.Models
@using x402dev.Shared.Interfaces
@implements IDisposable
@inject NavigationManager Navigation
@inject IX402ApiGrpcService X402ApiGrpcService

<div class="api-list">
	@if (ShowSearch)
	{
		<div class="api-list-toolbar">
			<FluentSearch @bind-Value="searchText"
						  @bind-Value:after="OnSearchChanged"
						  Placeholder="Search by url or description…"
						  aria-label="Search x402 APIs" />
		</div>
	}

	<FluentDataGrid @ref="grid" Id="x402apilist" ItemsProvider="@LoadItems" TGridItem="X402Api" AutoFit="true" MultiLine="true" ShowHover="true" OnRowClick="OnRowClicked" Pagination="@pagination">
		<TemplateColumn Title="Status" Sortable="true" Align="Align.Start" SortBy="@(GridSort<X402Api>.ByAscending(a => a.HasError))">
			<span class="fac-status @(context.HasError ? "fac-status--offline" : "fac-status--online")">
				<span class="fac-status-dot"></span>
				@(context.HasError ? "Error" : "OK")
			</span>
		</TemplateColumn>

		<TemplateColumn Title="API" Sortable="true" Align="Align.Start" SortBy="@(GridSort<X402Api>.ByAscending(a => a.Url))">
			<span class="fac-url">@context.Url</span>
			@if (!string.IsNullOrWhiteSpace(context.ServiceName))
			{
				<p class="fac-note">@context.ServiceName</p>
			}
		</TemplateColumn>

		@if (ShowDomainColumn)
		{
			<PropertyColumn Title="Domain" Property="@(a => a.Domain)" Sortable="true" Align="Align.Start" />
		}

		<TemplateColumn Title="Description" Align="Align.Start">
			@if (!string.IsNullOrWhiteSpace(context.Description))
			{
				<span>@context.Description</span>
			}
			else
			{
				<span class="fac-note">—</span>
			}
		</TemplateColumn>

		<TemplateColumn Title="Payments" Align="Align.Start">
			<div class="fac-networks">
				@foreach (var req in (context.Requirements ?? new()).Distinct().Take(10))
				{
					<FluentBadge Appearance="Appearance.Neutral" Circular="true">@(req.NetworkName ?? req.Network)</FluentBadge>
					<span class="fac-note">@(req.AmountFormatted ?? req.Amount) @(req.AssetName ?? req.Asset)</span>
				}
			</div>
		</TemplateColumn>

		<PropertyColumn Title="Version" Property="@(a => a.Version)" Sortable="true" Align="Align.Start" />

		<TemplateColumn Title="Last Check" Sortable="true" Align="Align.Start" SortBy="@(GridSort<X402Api>.ByDescending(a => a.LastCheck))">
			@if (context.LastCheck.HasValue)
			{
				<span class="fac-checked">@FormatDate(context.LastCheck.Value)</span>
			}
			@if (context.HasError && !string.IsNullOrWhiteSpace(context.ErrorMessage))
			{
				<p class="fac-note">@context.ErrorMessage</p>
			}
		</TemplateColumn>
	</FluentDataGrid>

	@if ((pagination.TotalItemCount ?? 0) > pagination.ItemsPerPage)
	{
		<FluentPaginator State="@pagination" />
	}
</div>

@code {
	[Parameter] public bool ShowSearch { get; set; } = true;
	[Parameter] public bool ShowDomainColumn { get; set; } = true;
	[Parameter] public string? ExcludeUrl { get; set; }
	[Parameter] public string? Domain { get; set; }
	[Parameter] public ListMode Mode { get; set; } = ListMode.All;
	[Parameter] public int PageSize { get; set; } = 20;

	private string searchText = string.Empty;
	private PaginationState pagination = new();
	private FluentDataGrid<X402Api>? grid;

	protected override void OnInitialized()
	{
		pagination = new PaginationState { ItemsPerPage = PageSize };
		pagination.TotalItemCountChanged += OnTotalItemCountChanged;
		base.OnInitialized();
	}

	private void OnTotalItemCountChanged(object? sender, int? count) => InvokeAsync(StateHasChanged);

	private async Task OnSearchChanged()
	{
		if (grid != null)
		{
			await grid.RefreshDataAsync();
		}
	}

	private async ValueTask<GridItemsProviderResult<X402Api>> LoadItems(GridItemsProviderRequest<X402Api> request)
	{
		var grpcRequest = new GetX402ApisPagedRequest
		{
			Skip = request.StartIndex,
			Take = request.Count ?? pagination.ItemsPerPage,
			Search = string.IsNullOrWhiteSpace(searchText) ? null : searchText.Trim(),
			Domain = Domain,
			ExcludeUrl = ExcludeUrl
		};

		foreach (var sort in request.GetSortByProperties())
		{
			grpcRequest.SortBy.Add(sort.Direction == SortDirection.Descending ? $"-{sort.PropertyName}" : sort.PropertyName);
		}

		var result = Mode == ListMode.Problems
			? await X402ApiGrpcService.GetX402ApisWithProblemsPaged(grpcRequest)
			: await X402ApiGrpcService.GetX402ApisPaged(grpcRequest);

		return GridItemsProviderResult.From(result.Items, result.TotalCount);
	}

	/// <summary>
	/// Reloads the current page from the server (e.g. after adding an API).
	/// </summary>
	public async Task RefreshAsync()
	{
		if (grid != null)
		{
			await grid.RefreshDataAsync();
		}
	}

	private void OnRowClicked(FluentDataGridRow<X402Api> row)
	{
		if (row.Item is { } api)
		{
			Navigation.NavigateTo($"x402-apis/detail?url={Uri.EscapeDataString(api.Url)}");
		}
	}

	private static string FormatDate(DateTime dt)
	{
		var diff = DateTime.UtcNow - dt.ToUniversalTime();
		return diff.TotalSeconds < 60  ? "just now"
			 : diff.TotalMinutes < 60  ? $"{(int)diff.TotalMinutes}m ago"
			 : diff.TotalHours < 24    ? $"{(int)diff.TotalHours}h ago"
			 : diff.TotalDays < 7      ? $"{(int)diff.TotalDays}d ago"
			 : dt.ToString("MMM d, yyyy");
	}

	public void Dispose()
	{
		pagination.TotalItemCountChanged -= OnTotalItemCountChanged;
	}
}
